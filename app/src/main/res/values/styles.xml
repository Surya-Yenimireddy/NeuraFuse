<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base App Theme — Dark Premium -->
    <style name="Theme.NeuraFuse" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>

        <!-- Fonts -->
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Light status bar icons (white on dark) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
    </style>

    <!-- NoActionBar variant (legacy compat) -->
    <style name="Theme.NeuraFuse.NoActionBar" parent="Theme.NeuraFuse">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Card Style -->
    <style name="NeuraCard">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Elevated Card -->
    <style name="NeuraCardElevated" parent="NeuraCard">
        <item name="cardBackgroundColor">@color/bg_card_elevated</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Primary Button -->
    <style name="NeuraButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Accent Button -->
    <style name="NeuraButtonAccent" parent="NeuraButton">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg_dark</item>
    </style>

    <!-- Danger Button -->
    <style name="NeuraButtonDanger" parent="NeuraButton">
        <item name="backgroundTint">@color/danger</item>
    </style>

    <!-- Outline Button -->
    <style name="NeuraButtonOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/primary_light</item>
    </style>

    <!-- Section Title -->
    <style name="NeuraSectionTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Subtitle Text -->
    <style name="NeuraSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Chip style -->
    <style name="NeuraChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/bg_card</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <!-- Time Picker Theme -->
    <style name="BluePickerTheme" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
    </style>

</resources>
